{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist"
  },
  "include": ["src/index.ts", "src/core/**/*.ts", "src/config/**/*.ts", "src/types/**/*.ts", "src/renderer/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
