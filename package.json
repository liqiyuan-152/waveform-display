{
  "name": "waveform-display",
  "version": "0.2.0",
  "description": "A configuration-driven SVG waveform display component for TypeScript applications.",
  "license": "MIT",
  "keywords": [
    "waveform",
    "svg",
    "chart",
    "visualization",
    "typescript",
    "d3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqiyuan-152/waveform-display.git"
  },
  "bugs": {
    "url": "https://github.com/liqiyuan-152/waveform-display/issues"
  },
  "homepage": "https://github.com/liqiyuan-152/waveform-display#readme",
  "type": "module",
  "main": "./dist/waveform-display.umd.cjs",
  "module": "./dist/waveform-display.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/waveform-display.js",
      "require": "./dist/waveform-display.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit && vue-tsc -p demo/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config demo/vite.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm build:demo",
    "preview": "vite preview --config demo/vite.config.ts",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-vue": "^5.2",
    "@vue/test-utils": "^2.4",
    "ant-design-vue": "^4.2",
    "jsdom": "^27.4.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "vue": "^3.5",
    "vue-tsc": "^3.1"
  }
}
